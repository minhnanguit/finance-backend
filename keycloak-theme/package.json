{
    "name": "finance-keycloak-theme",
    "version": "0.1.0",
    "description": "Finance mobile login theme for Keycloak 26",
    "repository": {
        "type": "git",
        "url": "git://github.com/codegouvfr/keycloakify-starter.git"
    },
    "type": "module",
    "scripts": {
        "generate-tokens": "node scripts/generate-tokens.mjs",
        "prebuild": "npm run generate-tokens",
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "build-storybook": "storybook build --output-dir storybook-static",
        "test:e2e": "playwright test",
        "prestorybook": "npm run generate-tokens",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write"
    },
    "license": "MIT",
    "keywords": [],
    "dependencies": {
        "keycloakify": "11.16.0",
        "lucide-react": "^0.468.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^9.15.0",
        "@playwright/test": "^1.64.1",
        "@storybook/react": "^8.1.10",
        "@storybook/react-vite": "^8.1.10",
        "@tailwindcss/vite": "^4.1.14",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "eslint-plugin-storybook": "^0.11.1",
        "globals": "^15.12.0",
        "prettier": "3.3.1",
        "storybook": "^8.1.10",
        "tailwindcss": "^4.1.14",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.15.0",
        "vite": "^5.0.8"
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    }
}
