{
  "realm": "finance",
  "displayName": "Finance",
  "enabled": true,
  "sslRequired": "external",

  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "editUsernameAllowed": false,
  "rememberMe": true,

  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "offlineSessionIdleTimeout": 2592000,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,

  "passwordPolicy": "length(12) and notUsername and passwordHistory(3) and hashAlgorithm(argon2)",

  "webAuthnPolicyRpEntityName": "Finance",
  "webAuthnPolicySignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyAttestationConveyancePreference": "none",

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@finance.local",
    "fromDisplayName": "Finance",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },

  "clients": [
    {
      "clientId": "finance-api",
      "name": "Finance Backend API",
      "description": "Resource server. Chi ton tai de lam gia tri aud. Khong bat flow nao.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "finance-mobile",
      "name": "Finance Mobile App",
      "description": "KMP app. Public client, Authorization Code + PKCE S256 (RFC 8252).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "com.uit.finance://oauth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.uit.finance://oauth/logout",
        "access.token.lifespan": "300",
        "client.session.idle.timeout": "0",
        "client.session.max.lifespan": "0"
      },
      "protocolMappers": [
        {
          "name": "finance-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "finance-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
