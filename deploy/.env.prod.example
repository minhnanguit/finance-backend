# Trên server: `make prod-secrets` tạo file thật từ mẫu này
# và sinh ngẫu nhiên các mật khẩu; chỉ còn điền tay các dòng đánh dấu (*).

# (*) Hostname công khai, không có https:// và không có / cuối. DNS phải trỏ về IP server.
DOMAIN=

# Sinh tự động bởi `make prod-secrets`
DB_PASSWORD=
KC_DB_PASSWORD=
RABBITMQ_PASSWORD=
KC_ADMIN_PASSWORD=
KC_FINANCE_BACKEND_SECRET=

# Brevo SMTP (Settings → SMTP & API). Mail verify / reset password của Keycloak đi qua đây.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# (*) Login SMTP Brevo, dạng xxxx@smtp-brevo.com
SMTP_USER=
# (*) SMTP key Brevo (tạo mới, dán thẳng vào đây, không gửi qua chat)
SMTP_PASSWORD=
# (*) Địa chỉ gửi — phải là sender ĐÃ VERIFY trong Brevo
SMTP_FROM=
SMTP_FROM_NAME=Finance
