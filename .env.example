DB_URL=jdbc:postgresql://localhost:5432/finance
DB_USER=finance
DB_PASSWORD=finance
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=finance
RABBITMQ_PASSWORD=finance

# ---- Keycloak ----
# Issuer là giá trị nằm TRONG token. Phải khớp KC_HOSTNAME ở deploy/docker-compose.yml.
# 10.0.2.2 = host loopback nhìn từ Android emulator.
KEYCLOAK_ISSUER_URI=http://10.0.2.2:8081/realms/finance
# JWKS được backend (chạy trên host) fetch qua localhost, không qua 10.0.2.2.
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/finance/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=finance-api
