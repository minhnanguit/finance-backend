DB_URL=jdbc:postgresql://localhost:5433/finance
DB_USER=finance
DB_PASSWORD=finance
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=finance
RABBITMQ_PASSWORD=finance

# ---- Keycloak ----
# Issuer là giá trị nằm TRONG token. Phải khớp KC_HOSTNAME ở deploy/docker-compose.yml.
# 10.0.2.2 = host loopback nhìn từ Android emulator.
KEYCLOAK_ISSUER_URI=http://10.0.2.2:8082/realms/finance
# `make tunnel` ghi KC_PUBLIC_URL=https://xxx.trycloudflare.com vào deploy/.env; Makefile tự đổi issuer
# thành $KC_PUBLIC_URL/realms/finance khi `make run`. JWKS vẫn tải qua localhost.
# JWKS được backend (chạy trên host) fetch qua localhost, không qua 10.0.2.2.
KEYCLOAK_JWK_SET_URI=http://localhost:8082/realms/finance/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=finance-api

# ---- Keycloak Admin API (xoá tài khoản) ----
# Client finance-backend trong realm-finance.json (service account, chỉ quyền manage-users).
# Secret KHÔNG có giá trị mặc định (quyền manage-users). Local: `make up` sinh vào deploy/.env, `make run` tự truyền.
# Production: lấy từ secret manager, không commit.
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8082
KEYCLOAK_ADMIN_CLIENT_SECRET=
