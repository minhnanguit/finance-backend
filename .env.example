# Copy to .env (git-ignored) or export in your shell. Defaults match deploy/docker-compose.yml.
DB_URL=jdbc:postgresql://localhost:5432/finance
DB_USER=finance
DB_PASSWORD=finance
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=finance
RABBITMQ_PASSWORD=finance
# Production only – PEM strings (PKCS#8 private, X.509 public). Leave empty locally for ephemeral keys.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
